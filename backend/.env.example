# ===== WAJIB =====
# Connection string PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finka

# Di produksi: NODE_ENV=production  (mewajibkan secret kuat & CORS_ORIGINS, dan mematikan akun demo)
NODE_ENV=development

# Secret acak minimal 32 karakter, JWT_SECRET dan QR_SECRET harus BERBEDA.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-rahasia-panjang
QR_SECRET=ganti-dengan-rahasia-qr-panjang

# URL frontend yang boleh memanggil API (pisahkan koma). Wajib di produksi.
# CORS_ORIGINS=https://finka.sekolah.sch.id

# ===== Rekening tujuan transfer (WAJIB di produksi) =====
# Ditampilkan ke orang tua pada instruksi transfer. Pastikan benar!
# REKENING_BANK=BCA
# REKENING_NOMOR=1234567890
# REKENING_ATAS_NAMA=Yayasan ...
# NAMA_YAYASAN=Yayasan ...        (opsional, default = atas nama rekening)
# ALAMAT_YAYASAN=Jl. ...          (opsional, tampil di kop invoice)

# ===== Admin pertama (hanya dipakai saat tabel users kosong di produksi) =====
# Setelah login pertama dan password diganti, hapus ADMIN_PASSWORD dari environment.
# ADMIN_USERNAME=kepala.yayasan
# ADMIN_PASSWORD=minimal-12-karakter
# ADMIN_NAMA=Admin Yayasan

# ===== Opsional =====
PORT=3001
# Jumlah proxy di depan app (Railway/Nginx = 1). Dipakai agar IP klien (rate limit & audit) benar.
# TRUST_PROXY=1
# Hanya untuk staging: SEED_DEMO=true memaksa akun demo (password lemah!) dibuat di produksi.
# SEED_DEMO=false

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
# Set true bila penyedia PostgreSQL mewajibkan SSL
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Batas pengajuan isi saldo (rupiah), batas nominal tagihan, dan jendela pembatalan transaksi oleh kasir (menit).
# TOPUP_MIN=10000
# TOPUP_MAKS=2000000
# TAGIHAN_MAKS=100000000
# VOID_MENIT=15
